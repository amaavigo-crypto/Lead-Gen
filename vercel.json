{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "fluid": true,
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "{api/_seo-page.bundle.js,src/{server,firebase}/**,dist/index.html}",
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/campaigns/process-active",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/inbound/whatsapp",
      "destination": "/api/inbound/whatsapp"
    },
    {
      "source": "/api/webhooks/umrah-demo",
      "destination": "/api/webhooks/umrah-demo"
    },
    {
      "source": "/api/webhooks/stripe",
      "destination": "/api/webhooks/stripe"
    },
    {
      "source": "/api/webhooks/meta",
      "destination": "/api/webhooks/meta"
    },
    {
      "source": "/api/webhooks/instagram",
      "destination": "/api/webhooks/instagram"
    },
    {
      "source": "/api/leads/inbound",
      "destination": "/api/leads/inbound"
    },
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/[...path]"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/[...path]?path=seo-page&kind=robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/[...path]?path=seo-page&kind=sitemap"
    },
    {
      "source": "/(.*)",
      "destination": "/api/[...path]?path=seo-page&p=/$1"
    }
  ]
}
