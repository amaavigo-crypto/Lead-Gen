# App & Server Configuration
PORT=3000
NODE_ENV=production
APP_URL=https://your-domain.com
ALLOWED_ORIGIN=https://your-domain.com

# Master Secrets Encryption Key (AES-256-GCM 32-byte hex string or 32+ char phrase)
SECRETS_MASTER_KEY=your_32_byte_aes_gcm_master_secret_key_hex_here

# Database (MongoDB) - REQUIRED. Use a replica set (MongoDB Atlas always is one) so transactions work.
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net
MONGODB_URI=
MONGODB_DB_NAME=umrah360
# Optional: connection pool size per server process (use a small number, e.g. 5, on Vercel/serverless)
MONGODB_MAX_POOL=10
# Optional: set to 'false' to stop the app creating its basic indexes on first use (run `npm run mongo:indexes` instead)
MONGODB_AUTO_INDEX=
# Optional: how often the browser re-checks live lists, in ms (default 5000)
VITE_DB_POLL_MS=

# Firebase Configuration (used for SIGN-IN only; data lives in MongoDB)
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
# Only used by `npm run migrate:mongo` to read the old Firestore data
FIRESTORE_DATABASE_ID=(default)

# Firebase Admin SDK (Server Service Account - JSON string or path)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Platform AI Provider Keys (platform-owned, tenants never set or see these)
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
# AI Agent backup: when OpenAI is unavailable (no credits, invalid key, rate limit, outage) the Agent
# continues on Gemini. Needs GEMINI_API_KEY. The second model is used when the first is rate limited.
# Image generation has no backup (OpenAI only).
AI_FALLBACK_MODEL_ID=gemini-3.8-flash
AI_FALLBACK_SECONDARY_MODEL_ID=gemini-3.1-flash-lite

# Email Infrastructure: Solicited Lane (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
# Outbound email via Resend: RESEND_FROM must be on a domain verified in Resend (SPF/DKIM)
RESEND_FROM=Sales <sales@yourdomain.com>
# Optional fallback Reply-To for Resend messages. Workspace inbound mailboxes are configured separately.
RESEND_REPLY_TO=
# Set to 'smtp' to force SMTP even when Resend is configured
EMAIL_PROVIDER=
# Set to 'true' to never fall back to SMTP when Resend rejects an email
RESEND_DISABLE_SMTP_FALLBACK=
RESEND_WEBHOOK_SECRET=whsec_your_resend_svix_signing_secret_here

# Meta WhatsApp Webhook Fallback Verification
META_WEBHOOK_VERIFY_TOKEN=your-random-meta-verify-token-here
# One Meta app (type: Business) powers WhatsApp + Messenger for every client workspace.
META_APP_ID=
META_APP_SECRET=
# WhatsApp Embedded Signup v4 configuration id (Facebook Login for Business > Configurations).
# Configure the WhatsApp Business App onboarding / Coexistence flow; API-only onboarding is rejected by the app.
META_WA_EMBEDDED_SIGNUP_CONFIG_ID=
# Required for storing per-workspace tokens encrypted (also used by Instagram/Microsoft)
SECRETS_MASTER_KEY=

# TEMPORARY (Meta App Review): lets a workspace admin connect Meta's own WhatsApp TEST number by pasting its
# ids + token (Settings > Connected Channels), because Embedded Signup is blocked until advanced access is approved.
# Leave empty/false in normal use. Set to 'true' only while recording the review videos, then remove it.
META_REVIEW_TEST_CONNECTION=

# Instagram Messaging API (Meta Developer App)
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_REDIRECT_URI=https://your-domain.com/api/instagram/oauth/callback
META_INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v23.0
INSTAGRAM_AI_MODEL=gpt-4o-mini

# Native Social Studio OAuth applications (server-side only; never expose secrets to the browser).
# Facebook Pages use the existing Amaavigo Meta app. Add this URI to Valid OAuth Redirect URIs and request Advanced Access for every needed permission.
META_FACEBOOK_REDIRECT_URI=https://leads.amaavigo.com/api/oauth/social/facebook/callback
META_FACEBOOK_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,pages_manage_engagement,read_insights,instagram_basic
# YouTube OAuth client from Google Cloud Console.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://leads.amaavigo.com/api/oauth/social/youtube/callback
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.upload https://www.googleapis.com/auth/youtube.readonly https://www.googleapis.com/auth/yt-analytics.readonly
# X OAuth 2.0 app (PKCE + confidential client support).
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://leads.amaavigo.com/api/oauth/social/x/callback
X_SCOPES=tweet.read tweet.write users.read offline.access media.write
# LinkedIn Developer App. Organization posting requires approved organization scopes/products.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://leads.amaavigo.com/api/oauth/social/linkedin/callback
LINKEDIN_SCOPES=openid profile w_member_social
# Optional, after LinkedIn grants the product/permissions: LINKEDIN_SCOPES=openid profile w_member_social w_organization_social r_organization_social r_organization_admin rw_organization_admin
LINKEDIN_VERSION=202611
# Reddit OAuth app. Commercial API permission/approval is independently required.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=https://leads.amaavigo.com/api/oauth/social/reddit/callback
REDDIT_SCOPES=identity submit read
# Keep false until Reddit approves Amaavigo's commercial Data API use. OAuth may capture consent, but no Reddit data endpoint, publishing or analytics is called until this is true.
REDDIT_DATA_API_APPROVED=false
REDDIT_APP_USER_AGENT=web:com.amaavigo.socialstudio:v1.0 (Amaavigo Social Studio)

# Outlook / Microsoft 365 inbound mailbox ("Sign in with Microsoft")
# See MICROSOFT_IMAP.md for full Entra setup. Required for Settings → Inbound → Outlook.
# Entra app registration: supported account types = any organizational directory + personal Microsoft accounts.
# Redirect URI (Web): https://your-domain.com/api/oauth/microsoft/callback
# API permissions (delegated): Office 365 Exchange Online -> IMAP.AccessAsUser.All, plus offline_access, openid, email, profile
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional: defaults to ${APP_URL}/api/oauth/microsoft/callback and "common"
MICROSOFT_REDIRECT_URI=
# Demo scheduling (Outlook calendar + Teams). Default: ${APP_URL}/api/oauth/microsoft-calendar/callback
# Entra: add this redirect URI. Graph delegated: Calendars.ReadWrite, OnlineMeetings.ReadWrite, openid, email, profile, offline_access
MICROSOFT_CALENDAR_REDIRECT_URI=
MICROSOFT_AUTH_TENANT=common

# Dedicated Amaavigo meeting participant invited to consented Google Meet demos.
MEETING_INTELLIGENCE_BOT_EMAIL=automation@amaavigo.com
# Server-to-server integration (keep these server-only; never add a VITE_ prefix).
MEETING_INTELLIGENCE_API_URL=https://meetings.amaavigo.com
MEETING_INTELLIGENCE_SERVICE_KEY=
MEETING_INTELLIGENCE_WEBHOOK_SECRET=

# Serverless / Vercel: secret for /api/inbound-mail/cron (polls every connected Gmail, Microsoft, and IMAP mailbox).
# Long-running `npm start` already polls every 30s and does not need this.
CRON_SECRET=

# Legacy Umrah360 Fallback SMTP (optional platform fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Per-workspace sending domains: comma-separated tenant ids that may keep sending from RESEND_FROM
# until they verify their own domain (e.g. PLATFORM_SENDER_TENANTS=umrah360). All other workspaces are
# blocked from sending until their domain is verified in Settings -> Email.
PLATFORM_SENDER_TENANTS=

# --- Billing (Stripe) ---
# Use TEST keys while in the sandbox. Webhook endpoint: https://<your-domain>/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: where Stripe sends customers back to (defaults to the request origin)
APP_URL=
# Days a workspace keeps access after a failed payment before being locked (default 7)
BILLING_GRACE_DAYS=7

# Google Calendar (demo scheduling). Server-side sign-in that stores a refresh token, so the calendar
# stays connected (no hourly re-sync). Create a "Web application" OAuth client in Google Cloud and add
# this redirect URI: ${APP_URL}/api/oauth/google-calendar/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
