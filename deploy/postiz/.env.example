# Copy to .env and replace every CHANGE_ME value before starting the stack.
# Do not commit the completed .env file.
POSTIZ_URL=https://publisher.amaavigo.com
POSTIZ_JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_48
POSTIZ_ENCRYPTION_KEY=CHANGE_ME_USE_A_LONG_RANDOM_ENCRYPTION_KEY
POSTIZ_DB_PASSWORD=CHANGE_ME_POSTIZ_DATABASE_PASSWORD
POSTIZ_TEMPORAL_DB_PASSWORD=CHANGE_ME_TEMPORAL_DATABASE_PASSWORD
DISABLE_REGISTRATION=true
POSTIZ_API_LIMIT=90

# Shared developer apps owned by Amaavigo. Customers authorize their own channels.
FACEBOOK_APP_ID=
